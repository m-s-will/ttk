<?xml version="1.0" encoding="UTF-8"?>
<!-- TODO 11: Add widgets to the ParaView UI that control the member variables of the vtk filter -->
<!-- NOTE: Unfortunately the widget types and their properties are not well documented. -->
<!--       The best thing you can do is to look at filters that have similar widgets you require and copy their source code. -->
<!--       Good resources are: IcoSphere.xml, PersistenceDiagram.xml, and ArrayEditor.xml -->
<ServerManagerConfiguration>
  <ProxyGroup name="filters">
    <SourceProxy name="ttkTemporalMergeTreeMap2" class="ttkTemporalMergeTreeMap2" label="TTK TemporalMergeTreeMap2">
      <Documentation long_help="TemporalMergeTreeMap2 Long" short_help="TemporalMergeTreeMap2 Short">This filter is a well documented ttk example filter that computes for each vertex of a vtkDataSet the average scalar value of itself and its neighbors.</Documentation>

      <!-- INPUT DATA OBJECTS -->
      <InputProperty  name="Member Nodes"
                      command="SetInputConnection"
                      port_index="0">
        <ProxyGroupDomain name="groups">
          <Group name="sources" />
          <Group name="filters" />
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkMultiBlockDataSet" />
        </DataTypeDomain>
        <InputArrayDomain name="input_array" attribute_type="point" number_of_components="1" />
        <Documentation>A vtkDataSet that has at least one point data scalar array that can be used to compute averages.</Documentation>
      </InputProperty>
      <InputProperty name="Member Arcs"
                      command="SetInputConnection"
                      port_index="1">
        <ProxyGroupDomain name="groups">
          <Group name="sources" />
          <Group name="filters" />
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkMultiBlockDataSet" />
        </DataTypeDomain>
        <InputArrayDomain name="input_array" attribute_type="point" number_of_components="1" />
        <Documentation>A vtkDataSet that has at least one point data scalar array that can be used to compute averages.</Documentation>
      </InputProperty>
      <InputProperty  name="Member Segmentations"
                      command="SetInputConnection"
                      port_index="2">
        <ProxyGroupDomain name="groups">
          <Group name="sources" />
          <Group name="filters" />
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkMultiBlockDataSet" />
        </DataTypeDomain>
        <InputArrayDomain name="input_array" attribute_type="point" number_of_components="1" />
        <Documentation>A vtkDataSet that has at least one point data scalar array that can be used to compute averages.</Documentation>
      </InputProperty>

      <!-- INPUT PARAMETER WIDGETS -->

      <!-- This is the VTK way of selecting arrays for processing by calling the SetInputArrayToProcess method -->
      <!-- (see ttkTemporalMergeTreeMap2.cpp for details) -->
      <StringVectorProperty name="InputArray"
                label="Input Array"
                command="SetInputArrayToProcess"
                element_types="0 0 0 0 2"
                number_of_elements="5"
                default_values="0 2 0 0 Scalar">
        <ArrayListDomain attribute_type="Scalars" name="array_list">
          <RequiredProperties>
            <Property function="Input" name="Member Segmentations" />
          </RequiredProperties>
        </ArrayListDomain>
        <Documentation>The scalar array that will be used to compute averages.</Documentation>
      </StringVectorProperty>

    <IntVectorProperty name="LayoutMode" command="SetLayoutMode" label="Layout Mode"
          number_of_elements="1" default_values="2">
          <EnumerationDomain name="enum">
              <Entry value="1" text="Pairwise Distance"/>
              <Entry value="2" text="Barycenter"/>
          </EnumerationDomain>
          <Documentation>

          </Documentation>
      </IntVectorProperty>

      <IntVectorProperty
      name="UseSlidingWindow"
      command="SetUseSlidingWindow"
      label="Use sliding window"
      number_of_elements="1"
      default_values="0">
        <Hints>
        <PropertyWidgetDecorator type="GenericDecorator"
                                  mode="visibility"
                                  property="LayoutMode"
                                  value="2" />
        </Hints>
        <Documentation>
          ToDo.
        </Documentation>
        <BooleanDomain name="bool"/>
      </IntVectorProperty>

      <IntVectorProperty
      name="SlidingWindowSize"
      command="SetWindowSize"
      label="Sliding window size"
      number_of_elements="1"
      default_values="5">
    <Hints>
        <PropertyWidgetDecorator type="GenericDecorator"
                                  mode="visibility"
                                  property="UseSlidingWindow"
                                  value="1" />

        </Hints>
        <Documentation>
          ToDo.
        </Documentation>
      </IntVectorProperty>
      <IntVectorProperty
      name="barycenterSize"
      command="SetMaxBarycenterSize"
      label="Max BarycenterSize(%)"
      number_of_elements="1"
      default_values="20">
      <Hints>
        <PropertyWidgetDecorator type="GenericDecorator"
                                  mode="visibility"
                                  property="LayoutMode"
                                  value="2" />
        </Hints>
        <Documentation>
          ToDo.
        </Documentation>
      </IntVectorProperty>


      <IntVectorProperty name="Backend" command="SetBackend" label="Backend"
          number_of_elements="1" default_values="0"
          panel_visibility="advanced">
          <EnumerationDomain name="enum">
            <Entry value="0" text="Wasserstein Distance (IEEE TVCG 2021)"/>
            <Entry value="1" text="Edit Distance (IEEE TVCG 2019)"/>
            <Entry value="3" text="Branch Mapping Distance (EuroVis 2022)"/>
            <Entry value="4" text="Path Mapping Distance (TopoInVis 2022)"/>
          </EnumerationDomain>
          <Hints>
            <PropertyWidgetDecorator type="GenericDecorator"
                           mode="visibility"
                           property="LayoutMode"
                           value="1" />
          </Hints>

          <Documentation>

          </Documentation>
      </IntVectorProperty>

      <IntVectorProperty
        name="BranchMetric"
        label="Branch Metric"
        command="SetBranchMetric"
        number_of_elements="1"
        default_values="0">
        <EnumerationDomain name="enum">
            <Entry value="0" text="Wasserstein first degree"/>
            <Entry value="1" text="Wasserstein second degree"/>
            <Entry value="2" text="Persistence"/>
            <Entry value="3" text="Shifting"/>
        </EnumerationDomain>
        <Hints>
          <PropertyWidgetDecorator type="GenericDecorator"
                                  mode="visibility"
                                  property="Backend"
                                  value="3" />
          </Hints>
          <Documentation>
            The metric used to compare branches in the algorithm.
          </Documentation>
        </IntVectorProperty>
      <DoubleVectorProperty
      name="Scaling"
      command="SetScaling"
      label="Set Vertical Scaling"
      number_of_elements="1"
      default_values="2.0">
        <!-- <Hints>

        </Hints> -->
        <Documentation>
          ToDo.
        </Documentation>
      </DoubleVectorProperty>
      <!-- Create a UI group that contains all input parameter widgets (here only one) -->
      <PropertyGroup panel_widget="Line" label="Input options">
        <Property name="InputArray" />
      </PropertyGroup>

      <!-- OUTPUT PARAMETER WIDGETS -->

      <!-- A string parameter that controls the name of the output array -->
      <!-- <StringVectorProperty name="OutputArrayName" label="Output Array Name" command="SetOutputArrayName" number_of_elements="1" default_values="AveragedScalarField" /> -->

      <!-- Create a UI group that contains all output parameter widgets (here only one) -->
      <!-- <PropertyGroup panel_widget="Line" label="Output options">
        <Property name="OutputArrayName" />
      </PropertyGroup> -->

      <!-- DEBUG -->
      ${DEBUG_WIDGETS}

      <!-- MENU CATEGORY -->
      <Hints>
        <ShowInMenu category="TTK - Misc" />
      </Hints>
    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>
